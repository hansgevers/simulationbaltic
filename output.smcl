. *>>>PREPARATION
. 
. label define isc 0 "None" 1 "Primary education" 2 "Lower secondary education" 3 "Upper secondary education" 4 "Post-secondary non-tertiary education" 5 "Bachelor's or equivalent level" 6 "Master's or equivalent level/Doctoral or equivalent level"
{txt}
{com}. label values isced isc
{txt}
{com}. label variable isced "Education"
{txt}
{com}. 
. generate income = thinc-ypen3
{txt}
{com}. 
. egen id= group(mergeid)
{txt}
{com}. 
. drop if cjs==-99
{txt}(70 observations deleted)

{com}. 
. generate educ=0
{txt}
{com}. replace educ=1 if isced==3 | isced==4
{txt}(5,234 real changes made)

{com}. replace educ=2 if isced>=5
{txt}(2,943 real changes made)

{com}. label define educL 0 "Less than primary, primary and lower secondary education (ISCED levels 0-2)" 1 "Upper secondary and post-secondary non-tertiary education (ISCED levels 3 and 4)" 2 "Tertiary education (ISCED levels 5-8)"
{txt}
{com}. label values educ educL
{txt}
{com}. 
. keep single ypen3 gender cjs age educ sphus country income gali id Qyear sphus
{txt}
{com}. 
. drop if ypen3>7000
{txt}(7 observations deleted)

{com}. 
. *additional age categorization to match Eurostat categories
. generate ageD=0
{txt}
{com}. replace ageD=1 if age>=55 & age<=64
{txt}(2,789 real changes made)

{com}. replace ageD=2 if age>=65 & age<=74
{txt}(3,129 real changes made)

{com}. replace ageD=3 if age>=75 & age<=84
{txt}(2,530 real changes made)

{com}. replace ageD=4 if age>=85
{txt}(848 real changes made)

{com}. label define ageDl 0 "Less than 55 years old" 1 "Between 55 and 64 years old" 2 "Between 65 and 74 years old" 3 "Between 75 and 84 years old" 4 "Older than 85 years"
{txt}
{com}. label values ageD ageDl
{txt}
{com}. 
. generate ageE=0
{txt}
{com}. replace ageE=1 if age>=55 & age<=64
{txt}(2,789 real changes made)

{com}. replace ageE=2 if age>=65
{txt}(6,507 real changes made)

{com}. label define agel 0 "Less than 55 years old" 1 "Between 55 and 64 years old" 2 "Older than 64 years"
{txt}
{com}. label values ageE agel
{txt}
